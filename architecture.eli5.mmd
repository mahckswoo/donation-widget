%% giving.sg donation widget — ELI5 architecture
flowchart TD
  V(["🙂 A visitor on the charity's website"])

  subgraph CHARITY["🏠 What the charity does — almost nothing"]
    M["🐷 Paste ONE line of code<br/>→ the giving.sg donate mascot appears<br/><i>(script tag + campaignGuid)</i>"]
  end

  subgraph DELIVER["💗 giving.sg hands out the mascot — when the page loads"]
    direction LR
    CDN["📦 Pickup counter<br/><i>cdn.giving.sg</i>"] --> WAF["🛡️ Security gate<br/><i>Imperva</i>"] --> S3["🗄️ Storeroom<br/><i>S3 · embed.js</i>"]
  end

  subgraph PAY["💗 giving.sg takes the donation — when the mascot is tapped"]
    IF["🪟 A giving.sg cashier window opens right on the page<br/>pick amount · tax-relief · pay<br/><i>(iframe checkout — all on giving.sg)</i>"]
  end

  MAIL["📬 giving.sg posts a receipt to the charity<br/>'someone gave!'<br/><i>(webhook · PartnerTransactionId)</i>"]

  NOTE["❌ OLD drawing: the charity's site phones giving.sg for money stuff (API call + CORS)<br/>✅ REALLY: giving.sg's own window just opens on the page.<br/>The charity never handles money and never makes the call."]

  M -. "page loads: go grab the mascot" .-> CDN
  S3 -. "mascot delivered" .-> M
  V == "taps the mascot" ==> IF
  IF -. "window's ✕ says 'cancel' → mascot closes it" .-> M
  IF == "after they pay" ==> MAIL

  classDef gsg fill:#1B3862,color:#ffffff,stroke:#132846,stroke-width:1px;
  classDef charity fill:#F4F6F8,color:#3C4048,stroke:#C2C5CB,stroke-width:1px;
  classDef note fill:#FDEEF1,color:#8a1d33,stroke:#F16577,stroke-width:1px;
  classDef visitor fill:#E4F5F2,color:#065f57,stroke:#02B5A0,stroke-width:1px;

  class V visitor;
  class M charity;
  class CDN,WAF,S3,IF,MAIL gsg;
  class NOTE note;
